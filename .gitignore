# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/

# --- Virtual environments ---
venv/
env/
.venv/
ENV/

# --- Streamlit ---
.streamlit/secrets.toml

# --- ML models / large artifacts (prototype: keep repo light) ---
models/*.pkl
models/*.joblib

# --- Data (raw data can be large / sensitive; keep out of git by default) ---
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# --- Editors / IDEs ---
.vscode/
.idea/
*.swp

# --- OS files ---
.DS_Store
Thumbs.db

# --- Testing ---
.pytest_cache/
.coverage
htmlcov/

# --- Environment variables ---
.env
